{
  "name": "notes-embeds",
  "version": "1.0.0",
  "description": "Iframe-based React toolkit for interactive Quartz notes",
  "scripts": {
    "build": "tsc && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "vite",
    "test:build": "node --experimental-vm-modules tests/build.mjs",
    "test:browser": "node tests/browser.mjs",
    "postinstall": "node patch-spice-ui.mjs",
    "prebuild": "node patch-spice-ui.mjs",
    "pretest": "node patch-spice-ui.mjs",
    "predev": "node patch-spice-ui.mjs"
  },
  "type": "module",
  "dependencies": {
    "@spice-ts/core": "0.4.0",
    "@spice-ts/ui": "0.3.1",
    "jsxgraph": "1.14.3",
    "katex": "^0.16.22",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/katex": "^0.16.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
